# Site (production root for absolute OG / canonical URLs)
NEXT_PUBLIC_SITE_URL=https://cove.will.me.uk

# Mixpanel (optional — without it, events log to the browser console in development)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Vercel Redis / Upstash (optional — without it, waitlist uses data/waitlist.json)
# Either pair works:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ArcAds creatives (prefer tools/arcads-claude-code/.env — see docs/ads/meta-creatives-hybrid.md)
# ARCADS_BASIC_AUTH='Basic your_base64_encoded_credentials_here'
# ARCADS_API_KEY=

# Meta Marketing API (optional, later — meta-ad-builder creates PAUSED ads only)
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_
# META_PAGE_ID=
# META_IG_USER_ID=
# META_PIXEL_ID=
# META_API_VERSION=v23.0

# LinkedIn + X skills (Publora — optional; draft-only without these)
# PUBLORA_API_KEY=
# LINKEDIN_PLATFORM_ID=linkedin-
# X_PLATFORM_ID=twitter-
# APIFY_TOKEN=
